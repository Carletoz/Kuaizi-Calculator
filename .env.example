# n8n webhook URLs for v3 scan pipeline
# Copy this file to .env and fill in your n8n instance URLs
VITE_N8N_SUPPLIER_WEBHOOK_URL=https://your-n8n-instance/webhook/supplier-scan
VITE_N8N_PRODUCT_WEBHOOK_URL=https://your-n8n-instance/webhook/product-scan

# OpenAI key used by v2 scan pipeline (keep for backward compatibility)
VITE_OPENAI_API_KEY=
